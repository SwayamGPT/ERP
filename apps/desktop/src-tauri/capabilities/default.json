{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": [
    "main",
    "display"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "whatsapp:*"
        },
        {
          "url": "upi:*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "sms:*"
        }
      ]
    }
  ]
}
